# Copy to `.env` and adjust for your local setup. `.env` is git-ignored.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (matches docker-compose.yml service `db`)
DATABASE_URL=postgres://lms:lms@localhost:5432/lms

# CORS / frontend origin
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT lifetimes (minutes / days)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
