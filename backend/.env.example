# Copy to `.env` and adjust for your local setup. `.env` is git-ignored.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (matches docker-compose.yml service `db`)
DATABASE_URL=postgres://lms:lms@localhost:5432/lms

# CORS / frontend origin
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT lifetimes (minutes / days)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Invitation mail. The console backend prints the accept link in the server log.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# To send real mail (e.g. Gmail with an app password), uncomment and fill in:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@localhost
FRONTEND_ORIGIN=http://localhost:5173
INVITATION_DAYS=7
